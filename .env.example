# saveme settings. Copy to .env and edit; .env is optional and every value below is the default.
# A blank or missing value means the default. An invalid value puts the app in degraded mode
# (the page shows a banner naming the variable, /health returns 503).

# Downloads that run at the same time (1-16).
MAX_ACTIVE_JOBS=2
# Downloads that may wait for a free slot; more are refused with "busy" (0-100).
MAX_QUEUED_JOBS=4
# Inspections that run at the same time (1-32).
MAX_ACTIVE_INSPECTIONS=4
# Seconds before an inspection gives up (5-300).
INSPECT_TIMEOUT_SECONDS=30
# Largest file one download may produce, in MB (1-102400).
MAX_FILE_SIZE_MB=2048
# Seconds before a download is stopped (10-86400).
MAX_JOB_SECONDS=1800
# Minutes a finished file waits to be saved before it is deleted (1-1440).
JOB_TTL_MINUTES=30
# Finished files kept at once; the oldest is deleted first (1-100).
MAX_READY_FILES=6
# Disk budget for TEMP_DIR in MB; must be at least 2 x MAX_FILE_SIZE_MB.
MAX_TOTAL_DISK_MB=10240
# Job workspace inside the container (absolute path, writable by uid 10001).
TEMP_DIR=/tmp/media-jobs
# Log level: debug, info, warning or error.
LOG_LEVEL=info
# Host names the browser may use to reach the app (comma-separated).
ALLOWED_HOSTS=localhost,127.0.0.1

# Read by Docker Compose, not the app: the port on 127.0.0.1 the app is published on (1-65535).
# Set 80 to open the app without a port in the URL.
SAVEME_PORT=8000
