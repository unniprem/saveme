# saveme settings. Copy to .env and edit; .env is optional and every value below is the default.
# A blank or missing value means the default. An invalid value puts the app in degraded mode
# (the page shows a banner naming the variable, /health returns 503).

# Downloads that run at the same time (1-16).
MAX_ACTIVE_JOBS=2
# Downloads that may wait for a free slot; more are refused with "busy" (0-100).
MAX_QUEUED_JOBS=4
# Inspections that run at the same time (1-32).
MAX_ACTIVE_INSPECTIONS=4
# Seconds before an inspection gives up (5-300).
INSPECT_TIMEOUT_SECONDS=30
# Largest file one download may produce, in MB (1-102400).
MAX_FILE_SIZE_MB=2048
# Seconds before a download is stopped (10-86400).
MAX_JOB_SECONDS=1800
# Minutes a finished file waits to be saved before it is deleted (1-1440).
JOB_TTL_MINUTES=30
# Finished files kept at once; the oldest is deleted first (1-100).
MAX_READY_FILES=6
# Disk budget for TEMP_DIR in MB; must be at least 2 x MAX_FILE_SIZE_MB.
MAX_TOTAL_DISK_MB=10240
# Videos open in Clip Studio at once; opening another closes the least recently used (1-20).
MAX_CLIP_SOURCES=2
# Job workspace inside the container (absolute path, writable by uid 10001).
TEMP_DIR=/tmp/media-jobs
# Log level: debug, info, warning or error.
LOG_LEVEL=info
# Host names the browser may use to reach the app (comma-separated).
ALLOWED_HOSTS=localhost,127.0.0.1

# --- AI Highlights (Clip Studio). An invalid value below turns off AI Highlights only;
# downloads and manual clipping keep working. See docs/OPENROUTER_SETUP.md.
# OpenRouter API key (https://openrouter.ai/keys). Blank turns AI analysis off; local
# transcription still works. Kept on the server: never sent to the browser or logged.
OPENROUTER_API_KEY=
# OpenRouter model id. Chosen 2026-11-24 from OpenRouter's catalogue for price, structured
# output and multilingual quality; any text model id from https://openrouter.ai/models works.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# OpenRouter API address (https only).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# deny: only use providers that don't store or train on prompts; allow: any provider.
OPENROUTER_DATA_COLLECTION=deny
# Most highlights one analysis may return (1-20).
AI_MAX_CLIPS=10
# Analyses (transcription and AI) that run at the same time (1-4); they never use download slots.
AI_MAX_CONCURRENT_JOBS=1
# Spending guard per analysis, in US dollars (0.001-100). An estimate checked by SaveMe, not a
# billing cap: set a credit limit on the OpenRouter key for that.
AI_MAX_COST_USD_PER_JOB=0.25
# Longest video AI Highlights takes, in minutes (1-1440).
AI_MAX_SOURCE_MINUTES=180
# Seconds before an analysis (transcription included) is stopped (60-86400).
AI_MAX_JOB_SECONDS=3600
# faster-whisper model for local transcription: tiny, base, small, medium, large-v3, turbo, ...
# Install it first: python -m app.whisper_models <name> (the Docker image has base).
WHISPER_MODEL=base
# CPU threads transcription may use (1-16).
WHISPER_CPU_THREADS=2
# Store when each word is spoken, for word-timed Auto Shorts captions (true/false). False saves
# some transcription time; captions then estimate word times within each line.
WHISPER_WORD_TIMESTAMPS=true

# --- Auto Shorts (rendering in Clip Studio). An invalid value below turns off Auto Shorts only.
# See docs/AUTO_SHORTS_DESIGN.md and docs/RENDERING_PRESETS.md.
# Renders that run at the same time (1-4); they never use download slots.
RENDER_MAX_CONCURRENT_JOBS=1
# Renders that may wait for a free slot; more are refused with "busy" (0-20).
RENDER_MAX_QUEUED_JOBS=4
# CPU threads one render may use for decoding, filters and x264 (1-16).
RENDER_CPU_THREADS=2
# Memory cap of the renderer process and the FFmpeg it runs, in MB (256-16384; enforced on Linux).
RENDER_MAX_MEMORY_MB=1536
# H.264 encoder: auto (VideoToolbox when FFmpeg has it, as on native macOS; else libx264),
# libx264 or h264_videotoolbox.
RENDER_ENCODER=auto
# Longest clip Auto Shorts renders, in seconds (5-1800).
RENDER_MAX_CLIP_SECONDS=300
# Seconds before one clip's render is stopped (60-86400).
RENDER_MAX_JOB_SECONDS=3600
# Frames a second sampled for face tracking (1-15).
RENDER_ANALYSIS_FPS=5
# Extra folder of caption fonts (absolute path; letters, digits and _ . / - only). Blank: system fonts.
RENDER_FONTS_DIR=

# Read by Docker Compose, not the app: the port on 127.0.0.1 the app is published on (1-65535).
# Set 80 to open the app without a port in the URL.
SAVEME_PORT=8000
